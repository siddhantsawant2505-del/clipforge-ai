# Twitch API
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_USER_TOKEN=your_twitch_user_oauth_token

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Google / YouTube
GOOGLE_CREDENTIALS_JSON=path/to/service_account_credentials.json
YOUTUBE_CLIENT_SECRET_JSON=path/to/youtube_oauth_client_secret.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_USER_ID=your_instagram_user_id

# App Settings
CLIP_DURATION=30
SPIKE_THRESHOLD=3.0
SPIKE_WINDOW_SECONDS=10
WATCHLIST=streamer1,streamer2,streamer3
POSTING_TIMES_IST=14:00,18:00,21:00
